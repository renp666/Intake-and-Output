{
  "name": "intake-and-output",
  "version": "1.0.0",
  "private": true,
  "description": "24小时出入量记录系统",
  "scripts": {
    "dev": "cd packages/server && npm run dev",
    "dev:patient": "cd packages/patient-app && npm run dev",
    "dev:nurse": "cd packages/nurse-app && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:patient\" \"npm run dev:nurse\"",
    "build": "cd packages/patient-app && npm run build && cd ../nurse-app && npm run build && cd ../server && npm run build",
    "build:server": "cd packages/server && npm run build",
    "build:patient": "cd packages/patient-app && npm run build",
    "build:nurse": "cd packages/nurse-app && npm run build",
    "db:push": "cd packages/server && npm run db:push",
    "db:seed": "cd packages/server && npm run db:seed",
    "db:studio": "cd packages/server && npm run db:studio",
    "lint": "cd packages/server && npm run lint && cd ../patient-app && npm run lint && cd ../nurse-app && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
