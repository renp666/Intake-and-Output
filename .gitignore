.env.test.local
.env.production.local

# IDE / 集成开发环境配置
.vscode/
.idea/
*.swp
*.swo
*~

# OS files / 操作系统生成的文件
.DS_Store
Thumbs.db
desktop.ini

# Logs / 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / 测试覆盖率报告
coverage/
.nyc_output/

# Turbo / Turborepo 缓存
.turbo/

# Vite / Vite 本地配置
*.local
CLAUDE.md

# TypeScript / TypeScript 构建信息
*.tsbuildinfo

