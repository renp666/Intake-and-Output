# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=*

# Trust Proxy (反向代理层数，生产环境必须设置)
# 开发环境直连: false
# Nginx 单层反代: 1
# 多层负载均衡: 2 或 'loopback'
# 详见: https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=1

# Patient App URL (for QR code generation)
# 【推荐】完整地址，设置后优先使用，适用于所有部署场景
# 生产环境示例: https://app.hospital.com 或 https://patient.hospital.com
# 内网部署示例: http://192.168.1.100:3001
# PATIENT_APP_URL=
# 患者端端口，默认 3001（仅在未设置 PATIENT_APP_URL 时生效）
# PATIENT_APP_PORT=3001

# Database URL (Prisma uses SQLite by default)
DATABASE_URL=file:./dev.db
