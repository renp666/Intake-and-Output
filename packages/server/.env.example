# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=*

# Patient App URL (for QR code generation)
PATIENT_APP_URL=http://localhost:5173

# Database URL (Prisma uses SQLite by default)
DATABASE_URL=file:./dev.db
